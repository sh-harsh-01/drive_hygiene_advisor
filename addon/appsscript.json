{
  "timeZone": "America/New_York",
  "exceptionLogging": "STACKDRIVER",
  "runtimeVersion": "V8",
  "oauthScopes": [
    "https://www.googleapis.com/auth/drive.metadata.readonly"
  ],
  "dependencies": {
    "enabledAdvancedServices": [
      {
        "userSymbol": "Drive",
        "serviceId": "drive",
        "version": "v3"
      }
    ]
  },
  "addOns": {
    "common": {
      "name": "Drive Hygiene Advisor",
      "logoUrl": "https://www.gstatic.com/images/icons/material/system/2x/drive_file_white_48dp.png",
      "layoutProperties": {
        "primaryColor": "#1a73e8",
        "secondaryColor": "#34a853"
      },
      "homepageTrigger": {
        "runFunction": "onHomepage",
        "enabled": true
      }
    },
    "drive": {
      "homepageTrigger": {
        "runFunction": "onDriveHomepage",
        "enabled": true
      },
      "onItemsSelectedTrigger": {
        "runFunction": "onDriveItemsSelected"
      }
    }
  }
}
